# ============================================================
# backend/.env.example  →  copy to .env.local for dev
# Set all of these in DigitalOcean App Platform or via systemd/PM2 in production.
# NEVER commit .env.local to git.
# ============================================================

# ── Server ────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Origin(s) allowed by CORS (comma-separated for multiple)
ALLOWED_ORIGIN=http://localhost:3000

# ── Auth ──────────────────────────────────────────────────────
# Must match NEXT_PUBLIC_FRIDAY_API_SECRET in the frontend
FRIDAY_API_SECRET=change-me-to-a-long-random-string

# Single-user identity (generate once: node -e "console.log(require('crypto').randomUUID())")
FRIDAY_USER_ID=00000000-0000-0000-0000-000000000000

# ── Supabase ──────────────────────────────────────────────────
# Backend uses the SERVICE ROLE key — never expose this to the browser
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── AI Providers ──────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

EMBEDDING_PROVIDER=openai          # openai | huggingface | ollama
OPENAI_API_KEY=sk_your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# HuggingFace (only needed if EMBEDDING_PROVIDER=huggingface)
# HUGGINGFACE_API_KEY=hf_your_key_here
# HUGGINGFACE_API_URL=https://api-inference.huggingface.co/pipeline/feature-extraction/BAAI/bge-large-en-v1.5

# Ollama (only needed if EMBEDDING_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# ── Google OAuth ──────────────────────────────────────────────
# OAuth redirect URI must point to THIS backend server.
# Update in Google Cloud Console → Credentials → OAuth 2.0 → Authorised redirect URIs.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/google/callback

# ── Workers ───────────────────────────────────────────────────
REFLECT_HOURS_BACK=24
