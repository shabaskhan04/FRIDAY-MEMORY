# ============================================================
# frontend/.env.example  →  copy to .env.local for dev
# These are the ONLY env vars the Next.js frontend needs.
# ============================================================

# Supabase (public — anon key, read-only access)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Password gate (single-user app lock screen)
NEXT_PUBLIC_APP_PASSWORD=friday

# DigitalOcean backend URL
NEXT_PUBLIC_FRIDAY_API_URL=https://api.friday.yourdomain.com

# Shared secret — must match FRIDAY_API_SECRET on the backend
# NOTE: This is NEXT_PUBLIC so client components can call the API.
# The app is single-user; treat this like a private API key.
NEXT_PUBLIC_FRIDAY_API_SECRET=change-me-to-a-long-random-string
