# ============================================================
# COGNITIVE ROUTER — Environment Variables
# Rename this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# App password — shown on the lock screen (default: "friday")
NEXT_PUBLIC_APP_PASSWORD=friday

# Groq — https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenAI embeddings - semantic memory search + optional ingest embeddings
OPENAI_API_KEY=sk_your_openai_api_key_here
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
